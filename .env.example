# NTSLLC — environment template
#
# Copy to .env.local for development; never commit a populated copy.
# Both .env.local and .env.production are gitignored.
#
# Vite exposes only `VITE_*`-prefixed variables to client code. If/when this
# project migrates to Next.js, replace these with NEXT_PUBLIC_* equivalents.

# Supabase project (anon key is public-by-design IF every public table has RLS).
# Reset both at https://supabase.com/dashboard/project/_/settings/api after the
# 2026-05-05 leak in commit 5793185 was force-removed from history.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=
