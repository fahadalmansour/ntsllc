{
  "name": "Neo Technology - Advanced Development Platform",
  "short_name": "Neo Tech",
  "description": "Enterprise-grade development platform with Firebase, Google Cloud, and advanced AI capabilities",
  "version": "1.0.0",
  "manifest_version": 3,
  
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#4AE54A",
  "background_color": "#0B0D12",
  
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32",
      "type": "image/x-icon"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  
  "categories": [
    "productivity",
    "developer",
    "business",
    "utilities"
  ],
  
  "screenshots": [
    {
      "src": "/screenshot-wide.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Neo Technology Dashboard"
    },
    {
      "src": "/screenshot-narrow.jpg", 
      "sizes": "640x1136",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Neo Technology Mobile"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Access your development dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/shortcut-dashboard.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Portfolio",
      "short_name": "Portfolio",
      "description": "View project portfolio",
      "url": "/portfolio",
      "icons": [
        {
          "src": "/shortcut-portfolio.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "API Management",
      "short_name": "APIs",
      "description": "Manage your APIs",
      "url": "/api-management",
      "icons": [
        {
          "src": "/shortcut-api.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "related_applications": [
    {
      "platform": "web",
      "url": "https://neotechnology.solutions"
    }
  ],
  
  "prefer_related_applications": false,
  
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"],
        "application/zip": [".zip"]
      }
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "neo",
      "url": "/handle?url=%s"
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/json",
            "text/*"
          ]
        }
      ]
    }
  },
  
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "permissions": [
    "notifications",
    "background-sync",
    "periodic-background-sync"
  ],
  
  "features": [
    "offline-support",
    "background-sync",
    "push-notifications",
    "cross-platform",
    "responsive-design",
    "accessibility"
  ]
}